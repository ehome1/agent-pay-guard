{
  "name": "agent-pay-guard",
  "version": "0.2.0",
  "description": "Local-first payment guard for AI agents. Check before your agent spends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ehome1/agent-pay-guard.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./adapters/stripe": {
      "import": {
        "types": "./dist/esm/adapters/stripe.d.ts",
        "default": "./dist/esm/adapters/stripe.js"
      },
      "require": {
        "types": "./dist/esm/adapters/stripe.d.ts",
        "default": "./dist/cjs/adapters/stripe.cjs"
      }
    },
    "./adapters/x402": {
      "import": {
        "types": "./dist/esm/adapters/x402.d.ts",
        "default": "./dist/esm/adapters/x402.js"
      },
      "require": {
        "types": "./dist/esm/adapters/x402.d.ts",
        "default": "./dist/cjs/adapters/x402.cjs"
      }
    }
  },
  "bin": {
    "agent-pay-guard": "./dist/cli/init.js"
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "keywords": [
    "ai-agent",
    "payment",
    "guard",
    "stripe",
    "x402",
    "agent-pay",
    "agentic-commerce"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "yaml": "^2.6.0"
  }
}
